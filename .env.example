# Copie este arquivo para .env e preencha com os valores reais.
# O .env é ignorado pelo git e nunca deve ser commitado.
NODE_ENV="production"
APPLICATION_PORT=3000

# Conexão com o banco PostgreSQL usado pelo Prisma (driver pg adapter).
# Aponte para a instância levantada via `docker compose up -d`.
DATABASE_URL="postgresql://oficina_user:oficina_pass@localhost:5433/oficina_db?schema=public"

# Usado para configurar acesso ao DB
OFICINA_USER="oficina_user"
OFICINA_PASSWORD="oficina_pass"
OFICINA_DB="oficina_db"

# Segredo usado para assinar/validar tokens JWT da autenticação administrativa.
# Em dev pode ser uma string longa aleatória; em prod deve vir do gerenciador de segredos.
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Tempo de expiração do access token. Aceita formatos do `ms` (ex.: "1h", "30m", "7d").
JWT_EXPIRES_IN="1h"

# Notificações serverless: o app NÃO fala SMTP direto — envia por HTTP para a
# Lambda de e-mail (repositório tc3-auth-lambda, rota /mail), que cuida do SMTP.
# MAIL_LAMBDA_URL   = output `mail_url` do Terraform da Lambda.
# MAIL_LAMBDA_TOKEN = parâmetro SSM MAIL_API_TOKEN (o header x-mail-api-token).
# A config de SMTP (host/user/pass) vive na Lambda, não aqui.
MAIL_LAMBDA_URL="https://<api-id>.execute-api.us-east-1.amazonaws.com/mail"
MAIL_LAMBDA_TOKEN="troque-pelo-MAIL_API_TOKEN-do-SSM"

# Token compartilhado com o sistema externo que envia callbacks de aprovação/recusa
# de orçamento para POST /webhooks/orcamento (header X-Webhook-Token).
# Em prod vem do K8s Secret; em dev gere uma string longa aleatória.
WEBHOOK_ORCAMENTO_TOKEN="troque-por-uma-string-longa-e-aleatoria"

# ─── New Relic (APM) ──────────────────────────────────────────────────────────
# Este arquivo é versionado: as chaves ficam VAZIAS aqui e nunca devem ser
# preenchidas neste arquivo. Os valores reais vão só no .env (ignorado pelo git).
# Em produção a license key vem do Secret `app-secret` (sincronizado do SSM).
NEW_RELIC_LICENSE_KEY=
# "false" no local: com as tags de produção, dados de dev se misturariam aos
# painéis do cluster e consumiriam a cota do free tier.
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=oficina-api
NEW_RELIC_LABELS="environment:production;project:tech-challenge-fiap"
